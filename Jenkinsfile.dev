pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {

        // Global
        OS_HOME  = '/home/ubuntu'
        PROJECT  = 'react_shopping_app'

        // AWS
        AWS_DEFAULT_REGION = 'ap-southeast-2'
    }

    stages {

        // ─────────────────────────────────────────────
        // Set config based on branch
        // ─────────────────────────────────────────────

        stage('Set Branch Config') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'dev') {
                        env.IMAGE_NAME     = 'react_shopping_app_dev'
                        env.CONTAINER      = 'react_shopping_app_dev'
                        env.HOST_PORT      = '3000'
                        env.CONTAINER_PORT = '80'
                        env.SECRET_MANAGER = 'react-app-dev-secrets'

                    } else if (env.BRANCH_NAME == 'qa') {
                        env.IMAGE_NAME     = 'react_shopping_app_qa'
                        env.CONTAINER      = 'react_shopping_app_qa'
                        env.HOST_PORT      = '3001'
                        env.CONTAINER_PORT = '80'
                        env.SECRET_MANAGER = 'react-app-qa-secrets'

                    } else {
                        error("Branch '${env.BRANCH_NAME}' is not configured for deployment.")
                    }

                    env.IMAGE_TAG   = "${env.BRANCH_NAME}_${env.BUILD_NUMBER}"
                    env.BUILD_PATH  = "${env.OS_HOME}/BUILDS/${env.PROJECT}/${env.IMAGE_NAME}/${env.BRANCH_NAME}"
                    env.CONFIG_PATH = "${env.OS_HOME}/container-configs/${env.BRANCH_NAME}/${env.IMAGE_NAME}"

                    echo "Branch      : ${env.BRANCH_NAME}"
                    echo "Image       : ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                    echo "Container   : ${env.CONTAINER}"
                    echo "Port        : ${env.HOST_PORT}:${env.CONTAINER_PORT}"
                    echo "Secret      : ${env.SECRET_MANAGER}"
                }
            }
        }

        // ─────────────────────────────────────────────
        // Prepare build directory
        // ─────────────────────────────────────────────

        stage('Prepare Build Directory') {
            steps {
                sh '''
                    set -e

                    echo "Preparing build directory..."

                    mkdir -p "${BUILD_PATH}"
                    mkdir -p "${CONFIG_PATH}"

                    echo "Cleaning old build..."
                    rm -rf "${BUILD_PATH:?}"/*

                    echo "Copying workspace..."
                    cp -R . "${BUILD_PATH}"
                    rm -rf "${BUILD_PATH}/.git"

                    echo "Build directory ready."
                '''
            }
        }

        // ─────────────────────────────────────────────
        // Generate build metadata
        // ─────────────────────────────────────────────

        stage('Generate Build Metadata') {
            steps {
                sh '''
                    set -e

                    cd "${BUILD_PATH}"

                    echo "Generating build metadata..."

cat > build_config.json <<EOF
{
  "BUILD_NUMBER":       "${BUILD_NUMBER}",
  "BUILD_ID":           "${BUILD_ID}",
  "BUILD_DISPLAY_NAME": "${BUILD_DISPLAY_NAME}",
  "JOB_NAME":           "${JOB_NAME}",
  "BRANCH":             "${BRANCH_NAME}",
  "IMAGE_NAME":         "${IMAGE_NAME}",
  "IMAGE_TAG":          "${IMAGE_TAG}",
  "CONTAINER":          "${CONTAINER}",
  "BUILD_TIME":         "$(date '+%Y-%m-%d %H:%M:%S')"
}
EOF

                    cat build_config.json
                    echo "Build metadata generated."
                '''
            }
        }

        // ─────────────────────────────────────────────
        // Load secrets from AWS Secrets Manager
        // ─────────────────────────────────────────────

        // stage('Load Secrets') {
        //     steps {
        //         withCredentials([[
        //             $class: 'AmazonWebServicesCredentialsBinding',
        //             credentialsId: 'aws-dev-creds'
        //         ]]) {
        //             sh '''#!/bin/bash
        //                 set -euo pipefail

        //                 cd "${BUILD_PATH}"

        //                 echo "Fetching secrets: ${SECRET_MANAGER}"

        //                 SECRET_JSON=$(aws secretsmanager get-secret-value \
        //                     --secret-id "${SECRET_MANAGER}" \
        //                     --query SecretString \
        //                     --output text)

        //                 echo "Generating appConfig.env..."

        //                 jq -r --argjson secrets "$SECRET_JSON" '
        //                     .env[]
        //                     | if $secrets[.] != null
        //                     then "\\(.)=\\($secrets[.]|tostring)"
        //                     else "# MISSING KEY: \\(.)"
        //                     end
        //                 ' env.json > appConfig.env

        //                 cp appConfig.env "${CONFIG_PATH}/appConfig.env"
        //                 echo "Secrets loaded."
        //             '''
        //         }
        //     }
        // }

        // ─────────────────────────────────────────────
        // Build Docker image
        // ─────────────────────────────────────────────

        stage('Docker Build') {
            steps {
                sh '''
                    set -e

                    cd "${BUILD_PATH}"

                    echo "Removing old images for ${IMAGE_NAME}:${BRANCH_NAME}_*..."
                    docker images --format "{{.Repository}}:{{.Tag}}" \
                        | grep "^${IMAGE_NAME}:${BRANCH_NAME}_" \
                        | grep -v "${IMAGE_TAG}" \
                        | xargs -r docker rmi -f 2>/dev/null || true

                    echo "Building image: ${IMAGE_NAME}:${IMAGE_TAG}"
                    docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" .

                    docker image prune -f
                    echo "Docker build complete."
                '''
            }
        }

        // ─────────────────────────────────────────────
        // Deploy container
        // ─────────────────────────────────────────────

        stage('Deploy Container') {
            steps {
                sh '''
                    set -e

                    echo "Stopping old container: ${CONTAINER}"
                    docker rm -f "${CONTAINER}" 2>/dev/null || true

                    echo "Checking port ${HOST_PORT} usage..."
                    EXISTING=$(docker ps -aq --filter "publish=${HOST_PORT}")
                    if [ -n "$EXISTING" ]; then
                        echo "Port in use — removing container: $EXISTING"
                        docker rm -f "$EXISTING"
                    fi

                    echo "Starting container..."
                    docker run -d \
                        --name "${CONTAINER}" \
                        -p "${HOST_PORT}:${CONTAINER_PORT}" \
                        --restart unless-stopped \
                        "${IMAGE_NAME}:${IMAGE_TAG}"

                    echo "Container started."
                    docker ps -a --filter "name=${CONTAINER}"
                '''
            }
        }

        // ─────────────────────────────────────────────
        // Cleanup
        // ─────────────────────────────────────────────

        stage('Cleanup') {
            steps {
                sh '''
                    docker image prune -f
                    echo "Cleanup done."
                '''
            }
        }
    }

    post {

        success {
            echo "✅ [${BRANCH_NAME}] Deployment successful — ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "❌ [${BRANCH_NAME}] Deployment failed — ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        always {
            sh '''
                echo "=== Container Status ==="
                docker ps -a || true
            '''
        }
    }
}